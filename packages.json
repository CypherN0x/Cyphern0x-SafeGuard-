{
  "name": "safeguardgx_js",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.cyphern0x.safeguardgx",
    "productName": "SafeGuardGX",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "requireAdministrator",
      "forceCodeSigning": false,
      "asar": false
    },
    "extraResources": [
      {
        "from": "../SafeGuard.exe",
        "to": "SafeGuard.exe"
      }
    ],
    "files": [
      "**/*",
      "!dist"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
